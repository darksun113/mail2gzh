# 应用配置
APP_NAME=mail2gzh
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mail2gzh
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_CHARSET=utf8mb4

# Gmail API 配置（OAuth 2.0 用户授权）
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_QUERY=is:unread label:inbox
GMAIL_MAX_RESULTS=50

# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-2025-08-07
OPENAI_MAX_TOKENS=4000

# 内容长度和发布控制
MAX_CONTENT_LENGTH=20000
DAILY_PUBLISH_LIMIT=1
BATCH_PUBLISH_LIMIT=5
OPENAI_TEMPERATURE=0.3

# 微信公众号配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_ACCESS_TOKEN_URL=https://api.weixin.qq.com/cgi-bin/token
WECHAT_MATERIAL_UPLOAD_URL=https://api.weixin.qq.com/cgi-bin/material/add_news
WECHAT_MESSAGE_SEND_URL=https://api.weixin.qq.com/cgi-bin/message/mass/sendall

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 翻译配置
TRANSLATION_SOURCE_LANG=en
TRANSLATION_TARGET_LANG=zh
TRANSLATION_MAX_LENGTH=2000

# 邮件处理配置
EMAIL_BATCH_SIZE=10
EMAIL_CHECK_INTERVAL=300  # 秒
